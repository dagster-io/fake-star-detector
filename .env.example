# =============================================================================
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env
#
# Note: .env files are gitignored and should never be committed to version control
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub API Configuration
# -----------------------------------------------------------------------------
# Required for the simpler model (stargazers analysis)
# 
# Get your token from: https://github.com/settings/tokens
# Required scopes: gist (for creating gists with analysis results)
# 
# This token is used to:
# - Fetch repository stargazers from GitHub API
# - Retrieve user profile information
# - Create gists with analysis results
GITHUB_ACCESS_TOKEN=ghp_YOUR_TOKEN_HERE

# -----------------------------------------------------------------------------
# DuckDB Configuration
# -----------------------------------------------------------------------------
# Required for the complex model (DuckDB archive data analysis)
# 
# Path to your DuckDB database file (will be created if it doesn't exist)
# Can be an absolute path or relative to the project root
# 
# Default: data/fake_star_detector.duckdb
# 
# The database file stores:
# - GitHub Archive data for analysis
# - Intermediate staging tables
# - Final fake star detection results
DUCKDB_DATABASE=data/fake_star_detector.duckdb

# -----------------------------------------------------------------------------
# Optional: Dagster Configuration
# -----------------------------------------------------------------------------
# These are optional and have sensible defaults
# Uncomment and modify if needed

# DAGSTER_HOME=/path/to/dagster/home
# DAGSTER_CURRENT_IMAGE=your-image-name
